# Cloudflare Pages response headers. Format: a URL pattern, then indented "Name: value" lines.
# Rules apply in order, and a header set by two rules is joined with a comma, so set each header once.

# The site is also reachable at dotmiraclecom.pages.dev. Keep that copy out of search results:
# https://dotmiracle.com is the only address Google should index.
https://dotmiraclecom.pages.dev/*
  X-Robots-Tag: noindex

# Built CSS and JavaScript carry a content hash in their file names, so browsers can keep them for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
